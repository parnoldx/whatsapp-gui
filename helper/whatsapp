_LID_MAP: dict[str, str] | None = None


def lid_pn_map(store: Path) -> dict[str, str]:
    """lid_jid <-> pn_jid, both directions, from whatsmeow's session store.

    WhatsApp splits one conversation across a phone-number JID and a LID JID;
    this map lets us stitch them back into a single thread.
    ponytail: cached for process lifetime; the GUI restarts the daemon, and a
    mapping added mid-session just shows up on next launch.
    """
    global _LID_MAP
    if _LID_MAP is not None:
        return _LID_MAP
    out: dict[str, str] = {}
    path = store / "session.db"
    if path.is_file():
        try:
            con = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
            try:
                for lid, pn in con.execute("SELECT lid, pn FROM whatsmeow_lid_map"):
                    lj, pj = f"{lid}@lid", f"{pn}@s.whatsapp.net"
                    out[lj] = pj
                    out[pj] = lj
            finally:
                con.close()
        except sqlite3.Error:
            pass
    _LID_MAP = out
    return out


def sibling_jids(store: Path, jid: str) -> list[str]:
    other = lid_pn_map(store).get(jid)
    return [jid, other] if other else [jid]


