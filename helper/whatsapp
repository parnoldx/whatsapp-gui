def cmd_voice_path() -> dict:
    folder = state_dir() / "voice-drafts"
    folder.mkdir(parents=True, exist_ok=True)
    os.chmod(folder, 0o700)
    path = folder / (secrets.token_hex(16) + ".ogg")
