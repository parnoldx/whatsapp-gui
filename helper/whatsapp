def _meta_og(page: str) -> dict:
    out: dict[str, str] = {}
    for tag in re.findall(r"<meta\b[^>]*>", page, re.I):
        prop = re.search(
            r"""(?:property|name)\s*=\s*['"](?:og|twitter):(title|description|image(?::secure_url)?)['"]""",
            tag,
            re.I,
        )
        content = re.search(r"""content\s*=\s*['"]([^'"]+)['"]""", tag, re.I)
        if not prop or not content:
            continue
        key = prop.group(1).lower()
        if key == "image:secure_url":
            key = "image"
        if key not in out:
            out[key] = html.unescape(content.group(1)).strip()
    return out


def _http_url(url: str) -> str:
    parsed = urlparse(str(url or "").strip())
    if parsed.scheme not in {"http", "https"}:
        return ""
    host = (parsed.hostname or "").lower()
    if not host or host in {"localhost", "127.0.0.1", "::1"} or host.endswith(".local"):
        return ""
    return parsed.geturl()


def _http_get(url: str, ua: str, timeout: int = 8, limit: int = 512 * 1024) -> tuple[bytes, str, str]:
    target = _http_url(url)
    if not target:
        return b"", "", ""
    req = Request(
        target,
        headers={
            "User-Agent": ua,
            "Accept": "text/html,application/xhtml+xml,application/json,image/*,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.9",
        },
        method="GET",
    )
    with urlopen(req, timeout=timeout) as resp:
        if getattr(resp, "status", 200) >= 400:
            return b"", "", resp.geturl() or target
        data = resp.read(limit)
        ctype = (resp.headers.get_content_type() or "").lower()
        return data, ctype, resp.geturl() or target


def fetch_og(url: str) -> dict:
    target = _http_url(url)
    if not target:
        return {}
    page = ""
    final = target
    for ua in (CRAWLER_UA, BROWSER_UA):
        try:
            raw, ctype, final = _http_get(target, ua)
        except Exception:
            continue
        if not raw or (ctype and "html" not in ctype and "xml" not in ctype and "json" not in ctype):
            continue
        page = raw.decode("utf-8", errors="replace")
        if "og:image" in page or "og:title" in page or "twitter:image" in page:
            break
    if not page:
        return {}
    og = _meta_og(page)
    image = og.get("image") or ""
    if image.startswith("//"):
        image = "https:" + image
    elif image and not image.startswith("http"):
        image = urljoin(final, image)
    image = _http_url(image)
    title = (og.get("title") or "").strip()
    description = (og.get("description") or "").strip()
    out = {}
    if title:
        out["title"] = title[:180]
    if description:
        out["description"] = description[:240]
    if image:
        out["imageUrl"] = image
    return out


def fetch_oembed(url: str, host: str) -> dict:
    template = OEMBED.get(host)
    if not template:
        return {}
    endpoint = template.format(url=quote(url, safe=""))
    try:
        raw, ctype, _final = _http_get(endpoint, BROWSER_UA, timeout=6, limit=64 * 1024)
    except Exception:
        return {}
    if not raw:
        return {}
    try:
        data = json.loads(raw.decode("utf-8", errors="replace"))
    except json.JSONDecodeError:
        return {}
    if not isinstance(data, dict):
        return {}
    out: dict[str, str] = {}
    title = str(data.get("title") or "").strip()
    author = str(data.get("author_name") or "").strip()
    thumb = str(data.get("thumbnail_url") or "").strip()
    if title:
        out["title"] = title[:180]
    if author:
        out["description"] = author[:240]
    if thumb:
        out["imageUrl"] = thumb
    return out


def link_thumb_dir() -> Path:
    path = state_dir() / "link-thumbs"
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, 0o700)
    return path


def cache_remote_image(url: str, key: str) -> str:
    target = _http_url(url)
    if not target:
        return ""
    dest = link_thumb_dir() / (hashlib.sha256(key.encode()).hexdigest() + ".jpg")
    if dest.is_file() and dest.stat().st_size > 0:
        return file_url(str(dest))
    try:
        raw, ctype, _final = _http_get(target, BROWSER_UA, timeout=8, limit=2 * 1024 * 1024)
    except Exception:
        return ""
    if not raw or len(raw) < 32:
        return ""
    if ctype and not ctype.startswith("image/") and raw[:3] not in {b"\xff\xd8\xff", b"\x89PN", b"GIF"}:
        return ""
    dest.write_bytes(raw)
    os.chmod(dest, 0o600)
    return file_url(str(dest))


def fetch_social_preview(url: str, host: str) -> dict:
    out = fetch_oembed(url, host)
    og = fetch_og(url)
    if og.get("title") and (not out.get("title") or out["title"] in {"Reel", "Post", "TikTok", "YouTube", "X", "Spotify"}):
        out["title"] = og["title"]
    elif og.get("title") and "title" not in out:
        out["title"] = og["title"]
    if og.get("description") and not out.get("description"):
        out["description"] = og["description"]
    if og.get("imageUrl") and not out.get("imageUrl"):
        out["imageUrl"] = og["imageUrl"]
    image = out.get("imageUrl") or ""
    if image:
        local = cache_remote_image(image, url)
        if local:
            out["imageUrl"] = local
    return out


def cmd_link_preview(url: str) -> dict:
    preview = describe_link(first_url(url) or url)
    if not preview:
        fail("url is missing")
    target = preview["url"]
    cache = load_link_cache()
    cached = cache.get(target)
    if isinstance(cached, dict) and (cached.get("title") or cached.get("imageUrl")):
        preview.update({k: cached[k] for k in ("title", "description", "imageUrl") if cached.get(k)})
        preview["fetched"] = True
        return preview
    fetched = fetch_social_preview(target, preview.get("host") or "")
    if fetched:
        keep = {k: fetched[k] for k in ("title", "description", "imageUrl") if fetched.get(k)}
        cache[target] = keep
        if len(cache) > 400:
            keys = list(cache.keys())
            for key in keys[: len(keys) - 400]:
                cache.pop(key, None)
        save_link_cache(cache)
        preview.update(keep)
    preview["fetched"] = True
    return preview


def attach_link_preview(text: str, cache: dict | None = None) -> dict:
    url = first_url(text)
    if not url:
        return {}
    preview = describe_link(url)
    cached = (cache or {}).get(url)
    if isinstance(cached, dict):
        for key in ("title", "description", "imageUrl"):
            if cached.get(key):
                preview[key] = cached[key]
        if cached.get("title") or cached.get("imageUrl"):
            preview["fetched"] = True
    return preview


