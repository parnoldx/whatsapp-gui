def cached_avatar_url(jid: str) -> str:
    path = avatar_file(jid)
    if path.is_file() and path.stat().st_size > 0:
        return file_url(str(path))
    return ""


def _picture_field(data: dict, *keys: str) -> str:
    for key in keys:
        value = data.get(key)
        if value:
            return str(value)
        for actual, item in data.items():
            if str(actual).lower() == key.lower() and item:
                return str(item)
    return ""


def cmd_avatar(store: Path, jid: str) -> dict:
    jid = require_jid(jid)
    local = avatar_file(jid)
    cached = cached_avatar_url(jid)
    index = load_avatar_index()
    entry = index.get(jid) if isinstance(index.get(jid), dict) else {}
    if cached:
        return {"jid": jid, "localPath": str(local), "fileUrl": cached, "id": str(entry.get("id") or "")}
    failed_at = int(entry.get("failedAt") or 0)
    if failed_at and int(time.time()) - failed_at < 600:
        return {"jid": jid, "localPath": "", "fileUrl": "", "id": ""}
    args = ["profile", "picture-info", "--jid", jid, "--preview"]
    known_id = str(entry.get("id") or "")
    if known_id:
        args.extend(["--existing-id", known_id])
    try:
        data = run_wacli(args, store=store, timeout=20, lock_wait="0s")
    except HelperError:
        index[jid] = {"id": known_id, "failedAt": int(time.time())}
        save_avatar_index(index)
        return {"jid": jid, "localPath": "", "fileUrl": "", "id": known_id}
    url = _picture_field(data, "url", "URL")
    pic_id = _picture_field(data, "id", "ID")
    if not url:
        index[jid] = {"id": pic_id or known_id, "failedAt": int(time.time())}
        save_avatar_index(index)
        return {"jid": jid, "localPath": "", "fileUrl": cached, "id": pic_id}
    try:
        raw, _ctype, _final = _http_get(url, BROWSER_UA, timeout=10, limit=1024 * 1024)
    except Exception:
        raw = b""
    if not raw:
        index[jid] = {"id": pic_id or known_id, "failedAt": int(time.time())}
        save_avatar_index(index)
        return {"jid": jid, "localPath": "", "fileUrl": "", "id": pic_id}
    local.write_bytes(raw)
    os.chmod(local, 0o600)
    index[jid] = {"id": pic_id, "failedAt": 0}
    save_avatar_index(index)
    return {"jid": jid, "localPath": str(local), "fileUrl": file_url(str(local)), "id": pic_id}


def unread_since(con: sqlite3.Connection, jid: str, ack: int) -> int:
    row = con.execute(
        """
        SELECT COUNT(*) FROM messages
        WHERE chat_jid = ?
          AND ts > ?
          AND IFNULL(from_me, 0) = 0
          AND IFNULL(deleted_for_me, 0) = 0
          AND IFNULL(reaction_to_id, '') = ''
          AND IFNULL(revoked, 0) = 0
        """,
        (jid, int(ack)),
    ).fetchone()
    return int(row[0] if row else 0)


def load_prefs() -> dict:
    path = prefs_path()
    if not path.is_file():
        return {"receipts": False, "acks": {}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"receipts": False, "acks": {}}
    if not isinstance(data, dict):
        return {"receipts": False, "acks": {}}
    acks = data.get("acks") if isinstance(data.get("acks"), dict) else {}
    clean = {}
    for key, value in acks.items():
        if JID_RE.match(str(key)):
            try:
                clean[str(key)] = int(value)
            except (TypeError, ValueError):
                continue
    return {"receipts": bool(data.get("receipts")), "acks": clean}


def save_prefs(prefs: dict) -> None:
    path = prefs_path()
    tmp = path.with_name(f".prefs.{secrets.token_hex(8)}.tmp")
    payload = {"receipts": bool(prefs.get("receipts")), "acks": prefs.get("acks") or {}}
    data = json.dumps(payload, ensure_ascii=False, indent=2) + "\n"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
        os.chmod(path, 0o600)
    finally:
        if tmp.exists():
            tmp.unlink(missing_ok=True)


def load_media_index() -> dict[str, str]:
