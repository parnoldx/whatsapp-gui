def media_ext(mime: str, filename: str, kind: str) -> str:
    name = Path(filename or "").suffix
    if name and len(name) <= 8:
        return name
    mime = (mime or "").split(";", 1)[0].strip().lower()
    if mime in MIME_EXT:
        return MIME_EXT[mime]
    return {
        "image": ".jpg",
        "sticker": ".webp",
        "gif": ".mp4",
        "video": ".mp4",
        "voice": ".ogg",
        "audio": ".ogg",
        "document": "",
    }.get(kind, "")


def emit(payload: dict) -> None:
    json.dump(payload, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")


def humanize_wacli_error(err: object) -> str:
    if isinstance(err, dict):
        err = err.get("message") or err.get("error") or err
    text = str(err or "").replace("\n", " ").strip()
    low = text.lower()
    if "locked" in low or "lock-wait" in low or "another wacli" in low:
        return "WhatsApp is busy syncing. Try again in a moment."
    if "timed out" in low or "timeout" in low:
        return "WhatsApp took too long to respond."
    if not text:
        return "wacli command failed"
    return text[:180]


def fail(message: str, code: int = 1) -> None:
    raise HelperError(humanize_wacli_error(message), code)


def require_jid(value: str | None) -> str:
    jid = str(value or "").strip()
    if not jid or not JID_RE.match(jid):
        fail("chat target is not a valid JID")
    return jid


def file_url(path: str | None) -> str:
    if not path:
        return ""
    return Path(path).resolve().as_uri()


def video_thumb(local: str) -> str:
    """JPEG of the first frame, written next to a downloaded video. Empty on miss."""
    src = Path(str(local or ""))
    if not src.is_file():
        return ""
    dest = src.with_suffix(".jpg")
    try:
        if dest.is_file() and dest.stat().st_size > 32 and dest.stat().st_mtime >= src.stat().st_mtime:
            return str(dest)
    except OSError:
        pass
    try:
        subprocess.run(
            [
                "ffmpeg",
                "-hide_banner",
                "-loglevel",
                "error",
                "-nostdin",
                "-y",
                "-ss",
                "0",
                "-i",
                str(src),
                "-frames:v",
                "1",
                "-q:v",
                "4",
                str(dest),
            ],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            timeout=8,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        if dest.is_file() and dest.stat().st_size > 32:
            os.chmod(dest, 0o600)
            return str(dest)
        dest.unlink(missing_ok=True)
    except OSError:
        pass
    return ""


def looks_like_id(text: str, jid: str = "") -> bool:
    name = str(text or "").strip()
    if not name or name.lower() in {"unknown", "unknown group"}:
        return True
    if jid and name == jid:
        return True
    return bool(JID_RE.match(name))


def fallback_from_jid(jid: str) -> str:
    value = str(jid or "").strip()
    if not value:
        return "Unknown"
    local, _, host = value.partition("@")
    if host in {"g.us", "lid"}:
        return "Unknown group"
    if local.isdigit() and len(local) >= 8:
        return "+" + local
    return "Unknown"


def pick_name(*parts: object, jid: str = "") -> str:
    for part in parts:
        text = str(part or "").strip()
        if text and not looks_like_id(text, jid):
            return text
    return fallback_from_jid(jid)


def placeholder_label(value: str) -> str:
    key = re.sub(r"\s+", " ", str(value or "").strip()).lower()
    if key in {"(message)", "message"}:
        return " "
    return PLACEHOLDERS.get(key, "")


def human_preview(raw: str) -> str:
    text = str(raw or "").replace("\n", " ").strip()
    if not text:
        return ""
    lines = [ln.strip() for ln in str(raw or "").splitlines() if ln.strip()]
    last = lines[-1] if lines else text
    mapped = placeholder_label(last).strip()
    if mapped:
        return mapped[:180]
    if placeholder_label(last):
        return ""
    url = first_url(text)
    if url:
        preview = describe_link(url)
        if preview and preview.get("site") and preview["site"] != preview.get("host"):
            if preview.get("label") and preview["label"] != preview["site"]:
                return f"{preview['site']} {preview['label']}"
            return preview["site"]
    return text[:180]


def visible_body(display: str, text: str, caption: str, kind: str) -> tuple[str, str]:
    caption_text = str(caption or "").strip()
    raw_text = str(text or "").strip()
    display_text = str(display or "").strip()
    if placeholder_label(caption_text):
        caption_text = ""
    if kind in MEDIA_KINDS:
        body = caption_text or raw_text
        if placeholder_label(body):
            body = ""
        return body, body
    body = raw_text or display_text
    lines = [ln.strip() for ln in body.splitlines()]
    while lines and placeholder_label(lines[-1]):
        lines.pop()
    body = "\n".join(lines).strip()
    if placeholder_label(body):
        body = caption_text
    return body, caption_text


def first_url(text: str) -> str:
    match = URL_RE.search(str(text or ""))
    if not match:
        return ""
    return match.group(0).rstrip(").,;:!?]}")


def describe_link(url: str) -> dict:
    raw = str(url or "").strip()
    if not raw:
        return {}
    parsed = urlparse(raw)
    host = (parsed.hostname or "").lower()
    if host.startswith("www."):
        host = host[4:]
    path = parsed.path or ""
    site = host
    label = host
    if host == "instagram.com":
        site = "Instagram"
        if "/reel/" in path:
            label = "Reel"
        elif "/p/" in path:
            label = "Post"
        elif "/tv/" in path:
            label = "Video"
        else:
            label = "Instagram"
    elif host in {"tiktok.com", "vm.tiktok.com"}:
        site, label = "TikTok", "TikTok"
    elif host in {"youtube.com", "youtu.be", "m.youtube.com"}:
        site, label = "YouTube", "YouTube"
    elif host in {"x.com", "twitter.com", "t.co"}:
        site, label = "X", "Post"
    elif host == "open.spotify.com":
        site, label = "Spotify", "Spotify"
    elif host in {"facebook.com", "fb.watch"}:
        site, label = "Facebook", "Facebook"
    return {
        "url": raw,
        "host": host,
        "site": site,
        "label": label,
        "title": label,
        "description": "",
        "imageUrl": "",
        "fetched": False,
    }


