class HelperError(Exception):
    def __init__(self, message: str, code: int = 1) -> None:
        super().__init__(message)
        self.code = code


def state_dir() -> Path:
    raw = os.environ.get("PA_WHATSAPP_STATE")
    if raw:
        path = Path(raw)
    else:
        xdg = os.environ.get("XDG_STATE_HOME")
        path = Path(xdg) / "pa-whatsapp" if xdg else Path.home() / ".local/state/pa-whatsapp"
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, 0o700)
    return path


def store_dir(explicit: str | None = None) -> Path:
    if explicit:
        return Path(explicit).expanduser()
    env = os.environ.get("WACLI_STORE_DIR")
    if env:
        return Path(env).expanduser()
    xdg = os.environ.get("XDG_STATE_HOME")
    if xdg:
        return Path(xdg) / "wacli"
    return Path.home() / ".local/state/wacli"


