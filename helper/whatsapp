def _sleep(seconds: float) -> None:
    time.sleep(seconds)


def _clipboard_text() -> str:
    wl = shutil.which("wl-paste")
    if not wl:
        return ""
    try:
        proc = subprocess.run([wl, "-n"], capture_output=True, timeout=2, check=False)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    if proc.returncode != 0 or not proc.stdout:
        return ""
    return proc.stdout.decode("utf-8", errors="replace")


def _set_clipboard(text: str) -> None:
    wl = shutil.which("wl-copy")
    if not wl:
        return
    try:
        subprocess.run(
            [wl, "--type", "text/plain"],
            input=text.encode("utf-8"),
            capture_output=True,
            timeout=2,
            check=False,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return


def _emoji_overlay_open() -> bool:
    try:
        proc = subprocess.run(
            ["hyprctl", "-j", "layers"],
            capture_output=True,
            timeout=2,
            check=False,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False
    return b"omarchy-emojis" in (proc.stdout or b"")


def _summon_emoji_picker() -> None:
    shell = shutil.which("omarchy-shell")
    if not shell:
        fail("omarchy-shell is not installed")
    proc = subprocess.run(
        [shell, "shell", "summon", "omarchy.emojis", "{}"],
        capture_output=True,
        timeout=5,
        check=False,
    )
    if proc.returncode != 0:
        fail("could not open emoji menu")


def reaction_from_clipboard(text: str) -> str:
    s = (text or "").strip()
    if not s or "\n" in s or len(s) > 32:
        return ""
    return s


def cmd_pick_emoji(*, watch_only: bool = False) -> dict:
    """Open the Omarchy emoji overlay and return the chosen glyph.

    The overlay copies via wl-copy then pastes with wtype; we watch the
    clipboard. ponytail: empty the clipboard first so picking the already-
    copied emoji still registers; restore on cancel.

    watch_only: the GUI already summoned the overlay (so it appears without
    waiting for this helper). Summoning again would toggle it closed.
    """
    old = _clipboard_text()
    seen = False
    if watch_only:
        appear = time.monotonic() + 2
        while time.monotonic() < appear:
            if _emoji_overlay_open():
                seen = True
                break
            got = reaction_from_clipboard(_clipboard_text())
            if got:
                return {"emoji": got}
            _sleep(0.05)
        if not seen:
            got = reaction_from_clipboard(_clipboard_text())
            return {"emoji": got}
        _set_clipboard("")
    else:
        _set_clipboard("")
        _summon_emoji_picker()
    deadline = time.monotonic() + 120
    while time.monotonic() < deadline:
        if _emoji_overlay_open():
            seen = True
        got = reaction_from_clipboard(_clipboard_text())
        if got:
            return {"emoji": got}
        if seen and not _emoji_overlay_open():
            _sleep(0.3)
            got = reaction_from_clipboard(_clipboard_text())
            if got:
                return {"emoji": got}
            if not watch_only:
                _set_clipboard(old)
            return {"emoji": ""}
        _sleep(0.05)
    if not watch_only:
        _set_clipboard(old)
    return {"emoji": ""}


def cmd_pick_files() -> dict:
    zenity = shutil.which("zenity")
    if not zenity:
        fail("zenity is not installed")
    proc = subprocess.run(
        [zenity, "--file-selection", "--multiple", "--separator=\n", "--title=Attach files"],
        capture_output=True,
        timeout=300,
        check=False,
    )
    if proc.returncode != 0:
        return {"files": []}
    files = []
    for line in proc.stdout.decode("utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line:
            continue
        path = validate_file(line)
        files.append({"path": str(path), "fileUrl": file_url(str(path)), "name": path.name})
        if len(files) >= MAX_FILES:
            break
    return {"files": files}


def cmd_clipboard() -> dict:
    wl = shutil.which("wl-paste")
    if not wl:
        fail("wl-clipboard is not installed")
    types = subprocess.run([wl, "-l"], capture_output=True, timeout=5, check=False)
    listed = types.stdout.decode("utf-8", errors="replace").splitlines()
    image_type = ""
    for candidate in ("image/png", "image/jpeg", "image/jpg", "image/webp", "image/gif"):
        if candidate in listed:
            image_type = candidate
            break
    if image_type:
        ext = {"image/png": ".png", "image/jpeg": ".jpg", "image/jpg": ".jpg", "image/webp": ".webp", "image/gif": ".gif"}[image_type]
        folder = state_dir() / "clipboard"
        folder.mkdir(parents=True, exist_ok=True)
        os.chmod(folder, 0o700)
        dest = folder / (secrets.token_hex(16) + ext)
        proc = subprocess.run([wl, "-t", image_type], capture_output=True, timeout=10, check=False)
        if proc.returncode != 0 or not proc.stdout:
            fail("clipboard image is empty")
        if len(proc.stdout) > MAX_FILE:
            fail("clipboard image is too large")
        dest.write_bytes(proc.stdout)
        os.chmod(dest, 0o600)
        return {"kind": "file", "path": str(dest), "fileUrl": file_url(str(dest)), "name": dest.name}
    text = subprocess.run([wl], capture_output=True, timeout=5, check=False)
    body = text.stdout.decode("utf-8", errors="replace")
    if len(body) > MAX_TEXT:
        fail("clipboard text is too long")
    return {"kind": "text", "text": body}


def cmd_open_file(path_str: str) -> dict:
    path = validate_file(path_str)
    opener = shutil.which("xdg-open") or "xdg-open"
    subprocess.Popen([opener, str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return {"opened": True}


