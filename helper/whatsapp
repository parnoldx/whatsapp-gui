    messages = sub.add_parser("messages")
    messages.add_argument("--chat", required=True)
    messages.add_argument("--limit", type=int, default=80)
    messages.add_argument("--before", type=int, default=0)

    parts = sub.add_parser("participants")
    parts.add_argument("--chat", required=True)

    send = sub.add_parser("send-text")
    send.add_argument("--chat", required=True)
    send.add_argument("--message", required=True)
    send.add_argument("--reply-to", default="")
    send.add_argument("--mention", action="append", default=[])

    sendf = sub.add_parser("send-file")
    sendf.add_argument("--chat", required=True)
    sendf.add_argument("--file", required=True)
    sendf.add_argument("--caption", default="")
    sendf.add_argument("--as", dest="as_type", default="auto")

    sendv = sub.add_parser("send-voice")
    sendv.add_argument("--chat", required=True)
    sendv.add_argument("--file", required=True)
    sendv.add_argument("--reply-to", default="")

    down = sub.add_parser("download")
    down.add_argument("--chat", required=True)
    down.add_argument("--id", required=True)

    react = sub.add_parser("react")
    react.add_argument("--chat", required=True)
    react.add_argument("--id", required=True)
    react.add_argument("--sender", default="")
    react.add_argument("--emoji", required=True)  # "" removes the reaction

    ack = sub.add_parser("ack")
    ack.add_argument("--chat", required=True)
    ack.add_argument("--ts", type=int, required=True)

    receipts = sub.add_parser("receipts")
    receipts.add_argument("--on", action="store_true")
    receipts.add_argument("--off", action="store_true")

    mark = sub.add_parser("mark-read")
    mark.add_argument("--chat", required=True)
    mark.add_argument("--ts", type=int, default=0)

    sync = sub.add_parser("sync")
    sync.add_argument("action", choices=["start", "stop", "status"])

    sub.add_parser("voice-path")
    sub.add_parser("pick-files")
    pick_emoji = sub.add_parser("pick-emoji")
    pick_emoji.add_argument("--watch-only", action="store_true")
    sub.add_parser("clipboard")

    openf = sub.add_parser("open-file")
    openf.add_argument("--file", required=True)

    linkp = sub.add_parser("link-preview")
    linkp.add_argument("--url", required=True)

    av = sub.add_parser("avatar")
    av.add_argument("--jid", required=True)
    return parser


def dispatch(args: argparse.Namespace) -> dict:
    store = store_dir(args.store)
    prune_media()
    cmd = args.cmd
    if cmd == "status":
        return cmd_status(store)
    if cmd == "chats":
        return {
            "chats": list_chats(store, args.query, args.limit, args.include_archived),
            "syncActive": sync_active(),
        }
    if cmd == "messages":
        return {"messages": list_messages(store, require_jid(args.chat), args.limit, args.before or None)}
    if cmd == "participants":
        return {"participants": list_participants(store, require_jid(args.chat))}
    if cmd == "send-text":
        return send_text(store, require_jid(args.chat), args.message, args.reply_to, args.mention)
    if cmd == "send-file":
        return send_file(store, require_jid(args.chat), args.file, args.caption, args.as_type)
    if cmd == "send-voice":
        return send_voice(store, require_jid(args.chat), args.file, args.reply_to)
    if cmd == "download":
        return download_media(store, require_jid(args.chat), args.id)
    if cmd == "react":
        return send_react(store, require_jid(args.chat), args.id, args.sender, args.emoji)
    if cmd == "ack":
        return cmd_ack(require_jid(args.chat), args.ts)
    if cmd == "receipts":
        if args.on == args.off:
            fail("pass --on or --off")
        return cmd_receipts(args.on)
    if cmd == "mark-read":
        return cmd_mark_read(store, require_jid(args.chat), args.ts)
    if cmd == "sync":
        return cmd_sync(args.action)
    if cmd == "voice-path":
        return cmd_voice_path()
    if cmd == "pick-files":
        return cmd_pick_files()
    if cmd == "pick-emoji":
        return cmd_pick_emoji(watch_only=bool(getattr(args, "watch_only", False)))
    if cmd == "clipboard":
        return cmd_clipboard()
    if cmd == "open-file":
        return cmd_open_file(args.file)
    if cmd == "link-preview":
        return cmd_link_preview(args.url)
    if cmd == "avatar":
        return cmd_avatar(store, args.jid)
    fail("unknown command")
    return {}


def run_once(parser: argparse.ArgumentParser, argv: list[str]) -> None:
    """Parse one command and emit its single JSON response line."""
    try:
        args = parser.parse_args(argv)
        emit({"ok": True, "data": dispatch(args)})
    except HelperError as err:
        emit({"ok": False, "error": str(err)})
    except SystemExit:
        emit({"ok": False, "error": "bad command"})
    except Exception:
        emit({"ok": False, "error": "helper error"})


def run_daemon() -> int:
    """Read newline-delimited JSON argv arrays on stdin, one response per line.

    Lets the GUI keep a single long-lived process instead of paying Python
    startup on every interaction.
    """
    parser = build_parser()
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            argv = [str(x) for x in json.loads(line)]
        except (json.JSONDecodeError, TypeError, ValueError):
            emit({"ok": False, "error": "bad command"})
        else:
            run_once(parser, argv)
        try:
            sys.stdout.flush()
        except BrokenPipeError:
            return 0
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv and argv[0] == "--daemon":
        try:
            return run_daemon()
        except (BrokenPipeError, KeyboardInterrupt):
            return 0
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
        emit({"ok": True, "data": dispatch(args)})
        return 0
    except HelperError as err:
        emit({"ok": False, "error": str(err)})
        return err.code
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
