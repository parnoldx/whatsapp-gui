def prune_media(days: int = 7, every: int = 6 * 3600) -> None:
    """Delete downloaded media older than `days`. Marker-gated so it runs
    at most once per `every` seconds regardless of how often it's called."""
    marker = state_dir() / ".media-pruned"
    now = time.time()
    try:
        if now - marker.stat().st_mtime < every:
            return
    except OSError:
        pass
    cutoff = now - days * 86400
    folder = state_dir() / "media"
    if folder.is_dir():
        for entry in folder.iterdir():
            try:
                if entry.is_file() and entry.stat().st_mtime < cutoff:
                    entry.unlink()
            except OSError:
                pass
    marker.touch()


def cached_media(jid: str, msg_id: str) -> str:
    return load_media_index().get(media_key(jid, msg_id), "")


def open_db(store: Path) -> sqlite3.Connection:
    path = db_path(store)
    if not path.is_file():
        fail("wacli store is not initialized")
    uri = path.resolve().as_uri() + "?mode=ro"
    try:
        con = sqlite3.connect(uri, uri=True, timeout=2.0)
    except sqlite3.Error:
        fail("could not open the local message store")
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA query_only=ON")
    return con


def unwrap_wacli(payload: dict) -> dict:
    if not isinstance(payload, dict):
        fail("wacli returned an unexpected payload")
    if payload.get("success") is False or payload.get("ok") is False:
        fail(payload.get("error") or "wacli command failed")
    data = payload.get("data")
    if data is None:
        return payload
    if not isinstance(data, dict) and not isinstance(data, list):
        return {"value": data}
    return data if isinstance(data, dict) else {"items": data}


def run_wacli(
    args: list[str],
    store: Path | None = None,
    timeout: int = 60,
    readonly: bool = False,
    lock_wait: str = "15s",
) -> dict:
    cmd = [WACLI, "--json"]
    if readonly:
        cmd.append("--read-only")
    if store is not None:
        cmd.extend(["--store", str(store)])
    if not readonly and lock_wait:
        cmd.extend(["--lock-wait", lock_wait])
    cmd.extend(args)
    try:
        proc = subprocess.run(
            cmd,
            capture_output=True,
            timeout=timeout,
            check=False,
        )
    except FileNotFoundError:
        fail("wacli is not installed")
    except subprocess.TimeoutExpired:
        fail("wacli timed out")
    if len(proc.stdout) > MAX_STDOUT or len(proc.stderr) > MAX_STDOUT:
        fail("wacli output was too large")
    raw = proc.stdout.decode("utf-8", errors="replace").strip()
    if not raw:
        err = proc.stderr.decode("utf-8", errors="replace").strip()
        fail(err.splitlines()[0][:180] if err else "wacli produced no output")
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        fail("wacli did not return JSON")
    if proc.returncode != 0:
        unwrap_wacli(payload if isinstance(payload, dict) else {})
        fail("wacli command failed")
    if not isinstance(payload, dict):
        fail("wacli returned an unexpected payload")
    return unwrap_wacli(payload)


def is_muted(muted_until: int, now: int) -> bool:
    if muted_until == -1:
        return True
    return muted_until > now


def media_kind(media_type: str | None, mime: str | None) -> str:
    kind = (media_type or "").strip().lower()
    mime = (mime or "").strip().lower()
    if kind in {"image", "video", "gif", "sticker", "document", "location"}:
        return kind
    if kind == "audio":
        if "opus" in mime or "ogg" in mime:
            return "voice"
        return "audio"
    if mime.startswith("image/"):
        return "sticker" if "webp" in mime else "image"
    if mime.startswith("video/"):
        return "gif" if "gif" in mime else "video"
    if mime.startswith("audio/"):
        return "voice" if "opus" in mime or "ogg" in mime else "audio"
    return "text" if not kind else "unknown"


def preview_text(row: sqlite3.Row) -> str:
    kind = media_kind(
        row["media_type"] if "media_type" in row.keys() else "",
        row["mime_type"] if "mime_type" in row.keys() else "",
    )
    body, _caption = visible_body(
        str(row["display_text"] if "display_text" in row.keys() else "") or "",
        str(row["text"] if "text" in row.keys() else "") or "",
        str(row["media_caption"] if "media_caption" in row.keys() else "") or "",
        kind,
    )
    if body:
        return body.replace("\n", " ").strip()[:180]
    return placeholder_label(kind) or human_preview(
        str(row["display_text"] if "display_text" in row.keys() else "") or ""
    )


def require_chat(con: sqlite3.Connection, jid: str) -> sqlite3.Row:
    row = con.execute(
        """
        SELECT c.jid, c.kind, c.name, c.last_message_ts, c.archived, c.pinned,
               c.muted_until, c.unread_count, g.is_parent, g.linked_parent_jid
        FROM chats c
        LEFT JOIN groups g ON g.jid = c.jid
        WHERE c.jid = ?
        """,
        (jid,),
    ).fetchone()
    if row is None:
        fail("that chat is not in the local store")
    if row["kind"] not in {"dm", "group"} and not (
        row["kind"] == "unknown" and jid.endswith("@lid")
    ):
        fail("only direct chats and groups are supported")
    if row["is_parent"]:
        fail("community parents are not supported")
    linked = row["linked_parent_jid"] or ""
    if linked:
        fail("community-linked groups are not supported")
    return row


def list_chats(store: Path, query: str = "", limit: int = 80, include_archived: bool = False) -> list[dict]:
    limit = max(1, min(int(limit), MAX_CHATS))
    now = int(time.time())
    needle = query.strip().lower()
    acks = (load_prefs().get("acks") or {})
    con = open_db(store)
    try:
        rows = con.execute(
            """
            SELECT c.jid, c.kind, c.name AS chat_name, c.last_message_ts, c.archived, c.pinned,
                   c.muted_until, c.unread, c.unread_count, g.is_parent, g.linked_parent_jid,
                   g.name AS group_name,
                   ct.full_name AS contact_full, ct.push_name AS contact_push,
                   ct.business_name AS contact_business, ct.first_name AS contact_first,
                   (
                     SELECT COALESCE(NULLIF(m.media_caption, ''), NULLIF(m.text, ''),
                                    NULLIF(m.display_text, ''), m.media_type)
                     FROM messages m
                     WHERE m.chat_jid = c.jid
                       AND IFNULL(m.deleted_for_me, 0) = 0
                       AND IFNULL(m.reaction_to_id, '') = ''
                     ORDER BY m.ts DESC
                     LIMIT 1
                   ) AS preview
            FROM chats c
            LEFT JOIN groups g ON g.jid = c.jid
            LEFT JOIN contacts ct ON ct.jid = c.jid
            WHERE (
                    c.kind IN ('dm', 'group')
                    OR (c.kind = 'unknown' AND c.jid LIKE '%@lid'
                        AND c.last_message_ts IS NOT NULL AND IFNULL(c.name, '') <> '')
                  )
              AND IFNULL(g.is_parent, 0) = 0
              AND IFNULL(g.linked_parent_jid, '') = ''
            ORDER BY c.pinned DESC, c.last_message_ts DESC
            """
        ).fetchall()
        out = []
        for row in rows:
            if not include_archived and row["archived"]:
                continue
            name = pick_name(
                row["group_name"],
                row["contact_full"],
                row["contact_business"],
                row["contact_push"],
                row["contact_first"],
                row["chat_name"],
                jid=row["jid"],
            )
            preview = human_preview(row["preview"] or "")
            if needle and needle not in name.lower() and needle not in preview.lower():
                continue
            last_ts = int(row["last_message_ts"] or 0)
            ack = int(acks.get(row["jid"], 0) or 0)
            if last_ts <= ack or not row["unread"]:
                # wacli's `unread` flag mirrors WhatsApp app state, so a 0 here
                # means the chat was read on another device (e.g. the phone).
                unread = 0
            elif ack > 0:
                unread = unread_since(con, row["jid"], ack)
            else:
                unread = int(row["unread_count"] or 0)
            kind = row["kind"] if row["kind"] in {"dm", "group"} else "dm"  # @lid chats
            out.append(
                {
                    "jid": row["jid"],
                    "kind": kind,
                    "isGroup": kind == "group",
                    "name": name,
                    "lastMessageTs": last_ts,
                    "archived": bool(row["archived"]),
                    "pinned": bool(row["pinned"]),
                    "muted": is_muted(int(row["muted_until"] or 0), now),
                    "unreadCount": unread,
                    "preview": preview,
                    "avatarUrl": cached_avatar_url(row["jid"]),
                }
            )
            if len(out) >= limit:
                break

        # Stitch LID and phone-number chats: WhatsApp treats them as one thread.
        lmap = lid_pn_map(store)
        present = {c["jid"] for c in out}
        out = [c for c in out
               if not (c["jid"].endswith("@lid") and lmap.get(c["jid"]) in present)]
        for chat in out:
            lid = lmap.get(chat["jid"])
            if not lid or not lid.endswith("@lid"):
                continue
            tail = con.execute(
                """
                SELECT ts, COALESCE(NULLIF(media_caption, ''), NULLIF(text, ''),
                       NULLIF(display_text, ''), media_type) AS preview
                FROM messages
                WHERE chat_jid = ? AND IFNULL(deleted_for_me, 0) = 0
                  AND IFNULL(reaction_to_id, '') = ''
                ORDER BY ts DESC LIMIT 1
                """,
                (lid,),
            ).fetchone()
            if tail and int(tail["ts"] or 0) > chat["lastMessageTs"]:
                chat["lastMessageTs"] = int(tail["ts"])
                merged_preview = human_preview(tail["preview"] or "")
                if merged_preview:
                    chat["preview"] = merged_preview
        out.sort(key=lambda c: (bool(c["pinned"]), c["lastMessageTs"]), reverse=True)
        return out
    finally:
        con.close()


def badge_count(chats: list[dict], prefs: dict) -> int:
    acks = prefs.get("acks") or {}
    total = 0
    for chat in chats:
        if chat.get("muted") or chat.get("archived"):
            continue
        ack = int(acks.get(chat["jid"], 0) or 0)
        if chat["lastMessageTs"] > ack and chat.get("unreadCount", 0) > 0:
            total += 1
    return total


def _collect_reactions(con: sqlite3.Connection, jids: list[str], ids: list[str]) -> dict[str, list[dict]]:
    """Map msg_id -> [{emoji, count, mine, who}], newest reaction per sender wins."""
    if not ids:
        return {}
    iph = ",".join("?" * len(ids))
    jph = ",".join("?" * len(jids))
    rows = con.execute(
        f"""
        SELECT m.reaction_to_id AS tid, m.reaction_emoji AS emoji,
               m.sender_jid AS sender, m.from_me AS mine,
               COALESCE(NULLIF(c.full_name, ''), NULLIF(c.push_name, ''),
                        NULLIF(c.first_name, ''), NULLIF(m.sender_name, '')) AS name
        FROM messages m
        LEFT JOIN contacts c ON c.jid = m.sender_jid
        WHERE m.chat_jid IN ({jph}) AND m.reaction_to_id IN ({iph})
        ORDER BY m.ts
        """,
        [*jids, *ids],
    ).fetchall()
    latest: dict[tuple[str, str], tuple[str, bool, str]] = {}
    for r in rows:
        key = (r["tid"], r["sender"] or ("me" if r["mine"] else ""))
        who = "You" if r["mine"] else str(r["name"] or "").strip()
        latest[key] = ((r["emoji"] or "").strip(), bool(r["mine"]), who)
    out: dict[str, list[dict]] = {}
    for (tid, _sender), (emoji, mine, who) in latest.items():
        if not emoji:
            continue
        bucket = out.setdefault(tid, [])
        for entry in bucket:
            if entry["emoji"] == emoji:
                entry["count"] += 1
                entry["mine"] = entry["mine"] or mine
                if who:
                    entry["who"].append(who)
                break
        else:
            bucket.append({"emoji": emoji, "count": 1, "mine": mine, "who": [who] if who else []})
    for bucket in out.values():
        bucket.sort(key=lambda e: -e["count"])
    return out


def _coalesce_reactions(entries: list[dict]) -> list[dict]:
    """Merge reaction buckets that share an emoji (album stub folded into a photo)."""
    out: dict[str, dict] = {}
    for e in entries:
        cur = out.get(e["emoji"])
        if cur:
            cur["count"] += e["count"]
            cur["mine"] = cur["mine"] or e["mine"]
            cur["who"] = cur["who"] + e.get("who", [])
        else:
            out[e["emoji"]] = dict(e)
    return sorted(out.values(), key=lambda e: -e["count"])


def list_messages(store: Path, jid: str, limit: int = 80, before: int | None = None) -> list[dict]:
    limit = max(1, min(int(limit), MAX_MESSAGES))
    con = open_db(store)
    try:
        require_chat(con, jid)
        sibs = sibling_jids(store, jid)
        jph = ",".join("?" * len(sibs))
        params: list = [*sibs]
        clause = ""
        if before:
            clause = "AND m.ts < ?"
            params.append(int(before))
        params.append(limit)
        rows = con.execute(
            f"""
            SELECT m.msg_id, m.chat_jid, m.ts, m.from_me, m.sender_jid, m.sender_name,
                   m.text, m.display_text, m.quoted_msg_id, m.quoted_sender_jid,
                   m.is_forwarded, m.edited, m.media_type, m.media_caption, m.filename,
                   m.mime_type, m.file_length, m.local_path, m.downloaded_at,
                   m.media_unavailable_at, m.revoked,
                   q.text AS quoted_text, q.display_text AS quoted_display,
                   q.sender_name AS quoted_sender_name, q.media_type AS quoted_media,
                   q.sender_jid AS quoted_real_sender,
                   loc.name AS loc_name, loc.address AS loc_address,
                   loc.latitude AS loc_lat, loc.longitude AS loc_lng,
                   sc.full_name AS sender_full, sc.push_name AS sender_push,
                   sc.business_name AS sender_business, sc.first_name AS sender_first,
                   qc.full_name AS quoted_full, qc.push_name AS quoted_push,
                   qc.business_name AS quoted_business, qc.first_name AS quoted_first
            FROM messages m
            LEFT JOIN messages q
              ON q.chat_jid = m.chat_jid AND q.msg_id = m.quoted_msg_id
            LEFT JOIN message_locations loc
              ON loc.chat_jid = m.chat_jid AND loc.msg_id = m.msg_id
            LEFT JOIN contacts sc ON sc.jid = m.sender_jid
            LEFT JOIN contacts qc ON qc.jid = COALESCE(NULLIF(q.sender_jid, ''), m.quoted_sender_jid)
            WHERE m.chat_jid IN ({jph})
              AND IFNULL(m.deleted_for_me, 0) = 0
              AND IFNULL(m.reaction_to_id, '') = ''
              {clause}
            ORDER BY m.ts DESC
            LIMIT ?
            """,
            params,
        ).fetchall()
        reactions = _collect_reactions(con, sibs, [r["msg_id"] for r in rows])
    finally:
        con.close()
    cache = load_link_cache()
    items = []
    pending_reax: list[dict] = []  # reactions from album-stub rows, awaiting a photo
    pending_sender = ""
    for row in reversed(rows):
        kind = media_kind(row["media_type"], row["mime_type"])
        text, caption = visible_body(row["display_text"] or "", row["text"] or "", row["media_caption"] or "", kind)
        if row["revoked"]:
            kind = "revoked"
            text = "This message was deleted"
            caption = ""
        local = str(row["local_path"] or "").strip()
        if not local or not Path(local).is_file():
            local = cached_media(row["chat_jid"], row["msg_id"])
        quoted = str(row["quoted_display"] or row["quoted_text"] or "").strip()
        quoted_kind = media_kind(row["quoted_media"], "") if row["quoted_media"] else "text"
        quoted_body, _quoted_caption = visible_body(quoted, row["quoted_text"] or "", "", quoted_kind)
        quoted = quoted_body or placeholder_label(quoted) or quoted
        if not quoted and row["quoted_media"]:
            quoted = placeholder_label(row["quoted_media"]) or quoted_kind
        sender_jid = row["sender_jid"] or ""
        quoted_jid = row["quoted_real_sender"] or row["quoted_sender_jid"] or ""
        # WhatsApp album containers are stored as content-less stub rows; they'd
        # render as blank bubbles. Drop them and carry any reaction (e.g. a heart
        # on the album) onto the album's first photo from the same sender.
        if not (text or caption or row["media_type"] or row["loc_name"]
                or row["revoked"] or row["quoted_msg_id"]):
            pending_reax += reactions.get(row["msg_id"], [])
            pending_sender = sender_jid
            continue
        row_reax = reactions.get(row["msg_id"], [])
        if pending_reax and sender_jid == pending_sender:
            row_reax = _coalesce_reactions(pending_reax + row_reax)
            pending_reax = []
        preview = attach_link_preview(text or caption, cache)
        items.append(
            {
                "id": row["msg_id"],
                "chatJid": jid,  # canonical: siblings (@lid) fold into the requested chat
                "ts": int(row["ts"] or 0),
                "fromMe": bool(row["from_me"]),
                "senderJid": sender_jid,
                "senderName": pick_name(
                    row["sender_name"],
                    row["sender_full"],
                    row["sender_business"],
                    row["sender_push"],
                    row["sender_first"],
                    jid=sender_jid,
                )
                if sender_jid
                else str(row["sender_name"] or "").strip(),
                "text": text,
                "caption": caption,
                "kind": kind if (row["media_type"] or row["loc_name"] or kind == "revoked") else "text",
                "quotedId": row["quoted_msg_id"] or "",
                "quotedSender": pick_name(
                    row["quoted_sender_name"],
                    row["quoted_full"],
                    row["quoted_business"],
                    row["quoted_push"],
                    row["quoted_first"],
                    jid=quoted_jid,
                )
                if (row["quoted_sender_name"] or quoted_jid)
                else "",
                "quotedText": quoted[:280],
                "forwarded": bool(row["is_forwarded"]),
                "edited": bool(row["edited"]),
                "filename": str(row["filename"] or "").strip(),
                "mimeType": str(row["mime_type"] or "").strip(),
                "fileLength": int(row["file_length"] or 0),
                "localPath": local,
                "fileUrl": file_url(local) if local and Path(local).is_file() else "",
                "thumbUrl": file_url(video_thumb(local)) if kind == "video" else "",
                "downloaded": bool(local and Path(local).is_file()),
                "unavailable": bool(row["media_unavailable_at"]),
                "reactions": row_reax,
                "myReaction": next((e["emoji"] for e in row_reax if e["mine"]), ""),
                "locationName": str(row["loc_name"] or "").strip(),
                "locationAddress": str(row["loc_address"] or "").strip(),
                "latitude": row["loc_lat"],
                "longitude": row["loc_lng"],
                "linkPreview": preview,
            }
        )
    if pending_reax and items:  # stub was the newest row: fall back to the prior message
        merged = _coalesce_reactions(items[-1]["reactions"] + pending_reax)
        items[-1]["reactions"] = merged
        items[-1]["myReaction"] = next((e["emoji"] for e in merged if e["mine"]), "")
    return items


def list_participants(store: Path, jid: str) -> list[dict]:
    con = open_db(store)
    try:
        chat = require_chat(con, jid)
        if chat["kind"] != "group":
            return []
        rows = con.execute(
            """
            SELECT p.user_jid, p.role,
                   COALESCE(NULLIF(c.full_name, ''), NULLIF(c.push_name, ''),
                            NULLIF(c.first_name, ''), p.user_jid) AS name
            FROM group_participants p
            LEFT JOIN contacts c ON c.jid = p.user_jid
            WHERE p.group_jid = ?
            ORDER BY name COLLATE NOCASE
            LIMIT ?
            """,
            (jid, MAX_PARTICIPANTS),
        ).fetchall()
    finally:
        con.close()
    out = []
    for row in rows:
        out.append(
            {
                "jid": row["user_jid"],
                "name": pick_name(row["name"], jid=row["user_jid"]),
                "role": row["role"] or "",
            }
        )
    return out


def validate_mentions(store: Path, chat_jid: str, mentions: list[str]) -> list[str]:
    if not mentions:
        return []
    allowed = {p["jid"] for p in list_participants(store, chat_jid)}
    out = []
    seen = set()
    for raw in mentions:
        jid = require_jid(raw)
        if jid not in allowed:
            fail("mention is not a member of this group")
        if jid not in seen:
            seen.add(jid)
            out.append(jid)
    return out


def validate_file(path_str: str) -> Path:
    path = Path(path_str).expanduser()
    if not path.is_absolute():
        fail("file path must be absolute")
    try:
        path = path.resolve(strict=True)
    except OSError:
        fail("file does not exist")
    if not path.is_file() or path.is_symlink():
        fail("path is not a regular file")
    st = path.stat()
    if not stat.S_ISREG(st.st_mode):
        fail("path is not a regular file")
    if st.st_size > MAX_FILE:
        fail("file is larger than 100 MiB")
    if st.st_size <= 0:
        fail("file is empty")
    return path


def is_ogg_opus(path: Path) -> bool:
    try:
        data = path.read_bytes()[:1024]
    except OSError:
        return False
    return data.startswith(b"OggS") and b"OpusHead" in data


def transcode_voice(path: Path) -> Path:
    if is_ogg_opus(path):
        return path
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        fail("voice notes must be OGG/Opus")
    dest = state_dir() / "voice-drafts" / (secrets.token_hex(16) + ".ogg")
    dest.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(dest.parent, 0o700)
    cmd = [
        ffmpeg, "-y", "-i", str(path),
        "-c:a", "libopus", "-b:a", "24k", "-ac", "1", "-ar", "48000",
        str(dest),
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=60, check=False)
    except subprocess.TimeoutExpired:
        fail("could not convert the voice note")
    if proc.returncode != 0 or not is_ogg_opus(dest):
        dest.unlink(missing_ok=True)
        fail("could not convert the voice note to OGG/Opus")
    os.chmod(dest, 0o600)
    return dest


def send_text(store: Path, jid: str, message: str, reply_to: str = "", mentions: list[str] | None = None) -> dict:
    text = message.replace("\r\n", "\n")
    if not text.strip():
        fail("message is empty")
    if len(text) > MAX_TEXT:
        fail("message is longer than 4096 characters")
    con = open_db(store)
    try:
        require_chat(con, jid)
    finally:
        con.close()
    args = ["send", "text", "--to", jid, "--message", text]
    if reply_to:
        args.extend(["--reply-to", reply_to])
    for mention in validate_mentions(store, jid, mentions or []):
        args.extend(["--mention", mention])
    return run_wacli(args, store=store, timeout=90)


def send_file(store: Path, jid: str, path_str: str, caption: str = "", as_type: str = "auto") -> dict:
    path = validate_file(path_str)
    con = open_db(store)
    try:
        require_chat(con, jid)
    finally:
        con.close()
    if len(caption) > MAX_TEXT:
        fail("caption is too long")
    args = ["send", "file", "--to", jid, "--file", str(path), "--as", as_type or "auto"]
    if caption.strip():
        args.extend(["--caption", caption])
    return run_wacli(args, store=store, timeout=180)


def send_voice(store: Path, jid: str, path_str: str, reply_to: str = "") -> dict:
    path = transcode_voice(validate_file(path_str))
    con = open_db(store)
    try:
        require_chat(con, jid)
    finally:
        con.close()
    args = ["send", "voice", "--to", jid, "--file", str(path)]
    if reply_to:
        args.extend(["--reply-to", reply_to])
    result = run_wacli(args, store=store, timeout=120)
    if path.parent == state_dir() / "voice-drafts":
        path.unlink(missing_ok=True)
    return result


def _existing_media(local: str) -> str:
    local = str(local or "").strip()
    return local if local and Path(local).is_file() else ""


def _resolve_download(dest: Path) -> Path:
    if dest.is_file() and dest.stat().st_size > 0:
        return dest
    if dest.is_dir():
        files = [p for p in dest.iterdir() if p.is_file() and p.stat().st_size > 0]
        if files:
            return max(files, key=lambda p: p.stat().st_mtime)
    siblings = [p for p in dest.parent.glob(dest.name + "*") if p.is_file() and p.stat().st_size > 0]
    if siblings:
        return max(siblings, key=lambda p: p.stat().st_mtime)
    fail("could not download that media")
    raise AssertionError


def download_media(store: Path, jid: str, msg_id: str) -> dict:
    sibs = sibling_jids(store, jid)
    con = open_db(store)
    try:
        require_chat(con, jid)
        jph = ",".join("?" * len(sibs))
        row = con.execute(
            f"SELECT msg_id, chat_jid, local_path, mime_type, media_type, filename "
            f"FROM messages WHERE chat_jid IN ({jph}) AND msg_id = ?",
            (*sibs, msg_id),
        ).fetchone()
        if row is None:
            fail("that message is not in this chat")
    finally:
        con.close()
    jid = row["chat_jid"]  # the sibling (@lid) the message actually lives in
    kind = media_kind(row["media_type"], row["mime_type"])
    local = _existing_media(row["local_path"]) or cached_media(jid, msg_id)
    if local:
        return {
            "id": msg_id,
            "localPath": local,
            "fileUrl": file_url(local),
            "thumbUrl": file_url(video_thumb(local)) if kind == "video" else "",
            "mimeType": str(row["mime_type"] or ""),
            "kind": kind,
            "filename": str(row["filename"] or ""),
        }
    folder = state_dir() / "media"
    folder.mkdir(parents=True, exist_ok=True)
    os.chmod(folder, 0o700)
    dest = folder / (media_key(jid, msg_id) + media_ext(str(row["mime_type"] or ""), str(row["filename"] or ""), kind))
    run_wacli(
        ["media", "download", "--chat", jid, "--id", msg_id, "--output", str(dest)],
        store=store,
        timeout=180,
        readonly=True,
    )
    local_path = _resolve_download(dest)
    os.chmod(local_path, 0o600)
    remember_media(jid, msg_id, local_path)
    return {
        "id": msg_id,
        "localPath": str(local_path),
        "fileUrl": file_url(str(local_path)),
        "thumbUrl": file_url(video_thumb(str(local_path))) if kind == "video" else "",
        "mimeType": str(row["mime_type"] or ""),
        "kind": kind,
        "filename": str(row["filename"] or Path(local_path).name),
    }


def send_react(store: Path, jid: str, msg_id: str, sender: str, emoji: str) -> dict:
    sibs = sibling_jids(store, jid)
    con = open_db(store)
    try:
        require_chat(con, jid)
        jph = ",".join("?" * len(sibs))
        row = con.execute(
            f"SELECT chat_jid, sender_jid, from_me FROM messages "
            f"WHERE chat_jid IN ({jph}) AND msg_id = ?",
            (*sibs, msg_id),
        ).fetchone()
    finally:
        con.close()
    if row is None:
        fail("that message is not in this chat")
    args = ["send", "react", "--to", row["chat_jid"], "--id", msg_id, "--reaction", emoji]
    target = (sender or (row["sender_jid"] or "")).strip()
    if target and not row["from_me"]:
        args.extend(["--sender", target])
    return run_wacli(args, store=store, timeout=60)


def sync_active() -> bool:
    try:
        proc = subprocess.run(
            ["systemctl", "--user", "is-active", "wacli-sync.service"],
            capture_output=True,
            timeout=5,
            check=False,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False
    return proc.stdout.decode().strip() == "active"


def cmd_sync(action: str) -> dict:
    if action not in {"start", "stop", "status"}:
        fail("unknown sync action")
    if action == "status":
        return {"active": sync_active()}
    try:
        proc = subprocess.run(
            ["systemctl", "--user", action, "wacli-sync.service"],
            capture_output=True,
            timeout=15,
            check=False,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        fail("could not talk to systemd")
    if proc.returncode != 0:
        fail("could not " + action + " background sync")
    return {"active": sync_active()}


def cmd_status(store: Path) -> dict:
    prefs = load_prefs()
    authenticated = False
    connected = False
    connection_state = ""
    try:
        data = run_wacli(["doctor", "--read-only"], store=store, timeout=10, readonly=True)
        authenticated = bool(data.get("authenticated"))
        connected = bool(data.get("connected"))
        connection_state = str(data.get("connection_state") or "")
    except HelperError:
        authenticated = db_path(store).is_file()
    chats = []
    if db_path(store).is_file():
        try:
            chats = list_chats(store, limit=MAX_CHATS)
        except HelperError:
            chats = []
    return {
        "authenticated": authenticated,
        "connected": connected,
        "connectionState": connection_state,
        "storeDir": str(store),
        "syncActive": sync_active(),
        "receipts": bool(prefs.get("receipts")),
        "acks": prefs.get("acks") or {},
        "unreadBadge": badge_count(chats, prefs),
        "chatCount": len(chats),
    }


